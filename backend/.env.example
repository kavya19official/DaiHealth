# Recommended: run npm start from the DAI root; it creates local databases and secrets.
# This template is for starting ONLY the Express patient/doctor app manually.
PORT=3001
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
# Set stable, private keys and writable persistent document storage in standalone deployments.
PATIENT_DOCS_DIR=
TIMELINE_AUDIT_KEY=
CONSENT_AUDIT_KEY=
CONSENT_RECEIPT_PRIVATE_KEY=
# NODE_ENV must remain development for local HTTP cookie authentication.
NODE_ENV=development
# Put the real key in backend/.env ONLY; never commit it here.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# Optional, user-approved general drafting only. Disabled by default.
# Choose a suitable text model explicitly; no automatic escalation or default large model.
DAI_COMPLEX_AI_ENABLED=false
DAI_COMPLEX_AI_MODEL=

# Optional "Sign in with Google" (Google Identity Services, Web client ID; no secret needed).
# Add your app origin (e.g. http://localhost:3001) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Optional login notice emails ("You have successfully logged in"). Gmail: use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional email verification for new patient accounts. Keep credentials server-side.
RESEND_API_KEY=
# Leave blank for the Resend testing sender. Set a verified sender for public delivery.
EMAIL_FROM=
# Set to your verified Resend account email while using the testing sender.
RESEND_TEST_EMAIL=
# Optional stable secret (32+ characters). Falls back to the configured JWT_SECRET.
SIGNUP_OTP_SECRET=
# Optional public HTTPS URL for the email logo.
EMAIL_LOGO_URL=

# Optional DaiCare AI assistance. Only aggregate features are sent after patient consent.
DAICARE_AI_ENABLED=false
DAICARE_AI_MODEL=
# Configure your existing dedicated TURN relay for remote consultations across networks.
DAI_TURN_URL=
DAI_TURN_USERNAME=
DAI_TURN_PASSWORD=

# Sukoon anonymous national session count. Off until privacy/clinical review and load testing.
# Never returns individual participants or locations; suppresses counts below ten.
SUKOON_AWAKE_COUNTS=false

# Optional clinician dictation: audio -> Sarvam, transcript -> extractive Gemini draft.
# Per-consultation patient/external-processing consent and doctor review are required.
SARVAM_API_KEY=
DAI_CONSULTATION_AI_ENABLED=false
DAI_CONSULTATION_AI_MODEL=
