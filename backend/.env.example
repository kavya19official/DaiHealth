# Recommended: run npm start from the DAI root; it creates local databases and secrets.
# This template is for starting ONLY the Express patient/doctor app manually.
PORT=3001
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
# NODE_ENV must remain development for local HTTP cookie authentication.
NODE_ENV=development
# Put the real key in backend/.env ONLY; never commit it here.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
