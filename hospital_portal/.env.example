# Local demo only. Generate fresh secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
POSTGRES_PASSWORD=replace-with-a-generated-secret
JWT_SECRET=replace-with-at-least-32-random-characters
DAI_DEMO_PASSWORD=Dai-Synthetic-2026!
# DAI_DEMO=true is explicit in Compose; OTP delivery is simulated and displayed.
# Production login fails closed until an external OTP provider is implemented.

# Optional separate ML service; otherwise API serves trained local artifacts.
DAI_ML_SERVICE_URL=
DAI_ML_SERVICE_TOKEN=

# Patient/doctor ultrasound workspaces, used by the full-app launcher.
DAI_ULTRASOUND_ENABLED=false
# Set these secrets before enabling. Keep the image key stable across restarts.
DAI_ULTRASOUND_IMAGE_KEY=
DAI_ULTRASOUND_GATEWAY_TOKEN=
DAI_ULTRASOUND_SERVICE_TOKEN=
DAI_ULTRASOUND_ML_ORIGIN=http://127.0.0.1:8200
DAI_ULTRASOUND_IMAGE_RETENTION_DAYS=30
# Optional evaluated research weights, on the private ML listener only.
DAI_ULTRASOUND_MODEL_DIR=
# Standalone private ML service: absolute path to the official SonoNet16 checkpoint.
# The private ML service uses the bundled checkpoint when no override is set.
# DAI_ULTRASOUND_PLANE_WEIGHTS=/private/models/SonoNet16.npz
